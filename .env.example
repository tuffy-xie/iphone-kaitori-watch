# ============ 買取X Open API ============
# 在 https://kaitorix.app/open/mypage 获取（Free プラン：30回/日・TPS=1）
# 本地演练不配置此项时自动使用 Mock 数据（KAITORIX_MOCK=1 或 DRY_RUN=true）
KAITORIX_API_KEY=
# KAITORIX_BASE_URL=https://kaitorix.app

# ============ Telegram Bot ============
# 找 @BotFather 创建 bot 得到 token；chat_id 可用 @userinfobot 或给 bot 发消息后调用 getUpdates 获取
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ Cloudflare D1（GitHub Actions 运行时必填）============
# Cloudflare Dashboard -> Workers & Pages -> D1 创建数据库后获得 database_id
# API Token 需要 D1 Edit 权限（My Profile -> API Tokens -> Create Token -> Edit Cloudflare D1）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
# 不配置 D1 时，本地自动使用 SQLite：data/local.db
# LOCAL_DB_PATH=./data/local.db

# ============ 运行模式 ============
# true = 演练模式：Telegram 消息只打印不发送，不写入去重状态
DRY_RUN=false
# 无 API Key 时是否允许使用 Mock 数据跑通流程（true 时仅为演练，不代表真实行情）
KAITORIX_MOCK=0
